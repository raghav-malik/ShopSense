# LLM provider: "openai", "groq" or "gemini" (all use the OpenAI Chat Completions API;
# Gemini via Google's OpenAI-compatible endpoint, default model gemini-3.8-flash)
LLM_PROVIDER=openai

# OpenAI API to use: "chat_completions" (default) or "responses".
# Responses allows reasoning together with tools (Chat Completions on GPT-6 needs
# reasoning off), records reasoning summaries in Langfuse, and defaults to
# reasoning effort "medium". Slower and ~2x the tokens per turn in testing.
# LLM_API=chat_completions

# OpenAI (get from https://platform.openai.com/api-keys) — required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_key_here

# Groq (get from https://console.groq.com) — required when LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here

# Gemini (get from https://aistudio.google.com/apikey) — required when LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here

# LLM config. Model, base URL and reasoning effort default per provider:
#   openai -> gpt-6-luna, https://api.openai.com/v1, reasoning_effort=none
#             (GPT-6 only allows function tools in Chat Completions with reasoning_effort=none)
#   groq   -> openai/gpt-oss-120b, https://api.groq.com/openai/v1
#   gemini -> gemini-3.8-flash, Google's OpenAI-compatible endpoint
# LLM_MODEL=gpt-6-luna
# Model for side jobs (follow-up suggestions, and checking that the user asked for a
# cart or preference change). Defaults per provider to its
# cheapest capable model: gpt-6-luna (openai), openai/gpt-oss-20b (groq),
# gemini-3.5-flash-lite (gemini).
# LLM_SMALL_MODEL=gpt-6-luna
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Langfuse (get from https://cloud.langfuse.com -> Project -> Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_DEBUG=True

# Database
DB_PATH=shopsense.db

# Logs: JSON lines with a request id (default), or readable text for local work
# LOG_FORMAT=text

# Agent
MAX_AGENT_STEPS=10
# Per-turn runaway guards: when either is reached the agent stops researching and
# answers from what it found. A normal turn uses ~15-20K tokens and ~$0.001.
# MAX_TURN_TOKENS=100000
# MAX_TURN_COST_USD=0.25
MAX_SEARCH_RESULTS=5
