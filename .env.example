# Groq (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# LLM config
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Langfuse (get from https://cloud.langfuse.com -> Project -> Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_DEBUG=True

# Database
DB_PATH=shopsense.db

# Agent
MAX_AGENT_STEPS=10
MAX_SEARCH_RESULTS=5
